    <!--
        Added the constraints for entity IntentEntity.
    -->
    <changeSet id="20250906125958-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="missing_entity_response_id"
                                 baseTableName="intent_entity"
                                 constraintName="fk_intent_entity__missing_entity_response_id"
